# Comfort Curators local development environment
# Copy to .env and adjust for local-only throwaway values.

# HTTP
CC_HTTP_PORT=8080
CC_BASE_URL=http://127.0.0.1:8080

# Logging
CC_LOG_LEVEL=info

# PostgreSQL
CC_DB_USER=ccuser
CC_DB_PASS=ccpass
CC_DB_NAME=comfort_curators
CC_DB_HOST=postgres
CC_DB_PORT=5432
CC_DB_SSLMODE=disable

# MinIO (S3-compatible object store)
CC_MINIO_USER=minioadmin
CC_MINIO_PASS=minioadmin
CC_S3_PORT=9000
CC_MINIO_CONSOLE_PORT=9001

# Model stub
CC_MODEL_PORT=8081
CC_MODEL_MODE=success

# Acceptance seed (only honored under the "acceptance" Compose profile)
CC_ENV=acceptance
CC_FIXTURE_PATH=.runtime/acceptance-fixture.json

# Compose
COMPOSE_PROJECT_NAME=comfort-curators-backend
